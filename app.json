{
  "expo": {
    "name": "Spot",
    "slug": "spot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spot",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spot.app.hk",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.spot.app.shared"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Spot uses your location to show you spots nearby on the map.",
        "NSCalendarsUsageDescription": "Spot can add planned visits to your calendar.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized recommendations.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["spot"]
          }
        ],
        "LSApplicationQueriesSchemes": ["spot"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spot.app",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-calendar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF6B35"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spot shows nearby spots on your map."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.spot.app.shared",
          "iosShareExtensionName": "SpotShare",
          "iosShareExtensionBundleIdentifier": "com.spot.app.hk.spotshare"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c8d398a5-4be8-421d-995d-76c1957129a7",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SpotShare",
                  "bundleIdentifier": "com.spot.app.hk.spotshare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.spot.app.shared"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "router": {}
    }
  }
}
