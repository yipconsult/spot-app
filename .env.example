# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Facebook App Token (for Instagram/Facebook oEmbed authentication)
# Format: app_id|app_secret — create a Meta App at https://developers.facebook.com/
# Optional: Instagram parsing still works without it, but authenticated access is more reliable
FB_APP_TOKEN=your-facebook-app-token-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
